{
  "name": "Payment",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "description": "Client record ID"
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "SETUP",
        "MONTHLY"
      ]
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "paidDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PAID",
        "OVERDUE"
      ],
      "default": "PENDING"
    }
  },
  "required": [
    "client",
    "amount",
    "type"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
