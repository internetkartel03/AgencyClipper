{
  "name": "ThumbnailMessage",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "description": "ThumbnailSession record ID"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session",
    "role",
    "content"
  ]
}