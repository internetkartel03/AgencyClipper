{
  "name": "AnalyticsSnapshot",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "description": "Client record ID"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "views": {
      "type": "number"
    },
    "subscribers": {
      "type": "number"
    },
    "watchHours": {
      "type": "number"
    },
    "impressionsCTR": {
      "type": "number"
    },
    "topVideos": {
      "type": "string",
      "description": "JSON-encoded top videos"
    }
  },
  "required": [
    "client",
    "date"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "role": "user" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
