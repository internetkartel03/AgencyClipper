{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "channelUrl": {
      "type": "string"
    },
    "channelThumbnail": {
      "type": "string"
    },
    "channelSummary": {
      "type": "string"
    },
    "contentStyleAnalysis": {
      "type": "string"
    },
    "offers": {
      "type": "string"
    },
    "contentStrategy": {
      "type": "string",
      "description": "JSON-encoded action and reasoning objects"
    },
    "growthOpportunities": {
      "type": "string",
      "description": "JSON-encoded list of growth opportunities"
    },
    "latestUploads": {
      "type": "string",
      "description": "JSON-encoded latest uploads classified by the four-minute duration rule"
    },
    "analysisUpdatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "suggestedTitles": {
      "type": "string",
      "description": "JSON-encoded persisted title suggestions"
    },
    "suggestedIdeas": {
      "type": "string",
      "description": "JSON-encoded persisted long-form ideas"
    },
    "planType": {
      "type": "string",
      "enum": [
        "TEAM_ONLY",
        "PERSONAL_INVOLVED",
        "CUSTOM"
      ]
    },
    "customPlanLabel": {
      "type": "string"
    },
    "setupFee": {
      "type": "number",
      "default": 30000
    },
    "monthlyFee": {
      "type": "number"
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CHURNED"
      ],
      "default": "ACTIVE"
    },
    "discordServerId": {
      "type": "string"
    },
    "googleAccountEmail": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "id": "{{user.id}}" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
