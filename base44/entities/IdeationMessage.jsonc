{
  "name": "IdeationMessage",
  "type": "object",
  "properties": {
    "thread": {
      "type": "string",
      "description": "IdeationThread record ID"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "thread",
    "role",
    "content"
  ]
}